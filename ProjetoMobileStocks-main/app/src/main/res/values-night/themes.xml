<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Night). -->
    <style name="Theme.ProjetoMobileStocks" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/bg_dark_blue</item>
        <item name="colorOnPrimary">@color/bg_dark_blue</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/bg_dark_blue_surface</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Background and surface -->
        <item name="android:windowBackground">@color/bg_dark_blue</item>
        <item name="colorSurface">@color/bg_dark_blue_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_dark_blue</item>
        <item name="android:navigationBarColor">@color/bg_dark_blue</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
